# Copy to .env and fill in. Never commit .env.

# ── Supabase (Project settings → API) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── This app ────────────────────────────────────────────────────────
# Public address of your deployment, no trailing slash. Used for OAuth redirects and email links.
APP_URL=http://localhost:3000
# Encrypts the Dropbox / Google Drive tokens stored in the database. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Shared secret your scheduler sends as the x-cron-secret header. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Cloud storage (set up one or both) ──────────────────────────────
# Dropbox app with "App folder" access. Redirect URI: ${APP_URL}/api/public/storage/dropbox/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Google OAuth client (Web application). Used for Google Drive and Google Calendar.
# Redirect URIs: ${APP_URL}/api/public/storage/google_drive/callback
#                ${APP_URL}/api/public/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (reads documents, answers questions) ─────────────────────────
# Any OpenAI-compatible API. Defaults to Google Gemini (key from https://aistudio.google.com/apikey).
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_MODEL_SMART=gemini-2.5-pro

# ── Email out: reminders and weekly digest (optional) ───────────────
RESEND_API_KEY=
EMAIL_FROM="Family Vault <vault@yourdomain.com>"

# ── Email in: forward documents to the vault (optional) ─────────────
# Domain your Postmark inbound server receives mail for, e.g. docs.yourdomain.com
VITE_INBOUND_EMAIL_DOMAIN=
# Basic-auth credentials you put in the Postmark inbound webhook URL
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
